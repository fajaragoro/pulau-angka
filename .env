# Konfigurasi Pulau Angka. Nilai di sini ikut ter-build ke frontend (bukan rahasia).
# Di Cloudflare Pages, nilai ini bisa ditimpa lewat Settings > Environment variables.

# Kode akses yang berlaku sekarang (4 digit).
VITE_ACCESS_CODE=3016
# true  = pengguna yang dulu sudah memasukkan kode lama tetap bisa masuk setelah kode diganti.
# false = setelah kode diganti, semua pengguna diminta memasukkan kode baru.
VITE_KEEP_OLD_USERS=true
# Link halaman pembayaran (Mayar/Lynk/Scalev).
VITE_PAYMENT_URL=https://example.com/bayar-pulau-angka
# Token Cloudflare Web Analytics (kosongkan untuk mematikan analytics).
VITE_CF_ANALYTICS_TOKEN=
